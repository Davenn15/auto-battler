[gd_resource type="Resource" script_class="AscensionFamily" format=3]

[ext_resource type="Script" path="res://data/ascensions/scripts/ascension_family.gd" id="1"]
[ext_resource type="Script" path="res://data/ascensions/scripts/ascension.gd" id="2"]
[ext_resource type="Script" path="res://data/ascensions/effects/backup_protocol_effect.gd" id="3"]

[sub_resource type="Resource" id="Effect_tier1"]
script = ExtResource("3")
health_share = 0.3

[sub_resource type="Resource" id="Effect_tier2"]
script = ExtResource("3")
health_share = 0.45

[sub_resource type="Resource" id="Effect_tier3"]
script = ExtResource("3")
health_share = 0.6

[sub_resource type="Resource" id="Ascension_tier1"]
script = ExtResource("2")
description = "Choose a unit: the first time it would die each combat, it Revives with {health_share%} of its max health."
tier = 1
target = 1
effect = SubResource("Effect_tier1")

[sub_resource type="Resource" id="Ascension_tier2"]
script = ExtResource("2")
description = "Choose a unit: the first time it would die each combat, it Revives with {health_share%} of its max health."
tier = 2
target = 1
effect = SubResource("Effect_tier2")

[sub_resource type="Resource" id="Ascension_tier3"]
script = ExtResource("2")
description = "Choose a unit: the first time it would die each combat, it Revives with {health_share%} of its max health."
tier = 3
target = 1
effect = SubResource("Effect_tier3")

[resource]
script = ExtResource("1")
family_name = "Backup Protocol"
versions = Array[ExtResource("2")]([SubResource("Ascension_tier1"), SubResource("Ascension_tier2"), SubResource("Ascension_tier3")])
