[sub_resource type="Resource" id="Ascension_tier2"]
script = ExtResource("2")
description = "You get a random Keepsake. Your units holding at least one Keepsake gain {health} Health and {insight} Insight."
tier = 2
granted_keepsakes = 1
effect = SubResource("Effect_tier2")

[sub_resource type="Resource" id="Ascension_tier3"]
script = ExtResource("2")
description = "You get a random Keepsake. Your units holding at least one Keepsake gain {health} Health and {insight} Insight."
tier = 3
granted_keepsakes = 1
effect = SubResource("Effect_tier3")

[resource]
script = ExtResource("1")
family_name = "Fabrication"
versions = Array[ExtResource("2")]([SubResource("Ascension_tier1"), SubResource("Ascension_tier2"), SubResource("Ascension_tier3")])
