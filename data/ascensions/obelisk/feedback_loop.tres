[sub_resource type="Resource" id="Ascension_tier4"]
script = ExtResource("2")
description = "Your units gain {regen_per_stack} Regeneration for each stack of Mono-Virus on enemies within {radius_cells} cells of them (up to {max_stacks} stacks)."
