[resource]
script = ExtResource("1")
ascension_name = "Mortar Uplink"
description = "The first time BAR.RAJ plays his Gambit each combat, a Mortar Drone appears beside him for the rest of combat. It has 30% of his max health and his Wards, never moves or attacks, and every 5 seconds fires a volley of 3 of his Gambit's missiles at 70% damage."
