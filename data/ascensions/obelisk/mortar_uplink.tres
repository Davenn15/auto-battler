[resource]
script = ExtResource("1")
ascension_name = "Mortar Uplink"
description = "The first time Barrage plays his Gambit each combat, a Mortar Drone appears beside him for the rest of combat. It has {health_share%|maxhp} health and his Wards, never moves or attacks, and every {volley_interval} seconds fires a volley of {volley_missiles} of his Gambit's missiles at {damage_share%} damage."
