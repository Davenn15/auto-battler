[gd_resource type="Resource" script_class="AscensionFamily" format=3]

[ext_resource type="Script" path="res://data/ascensions/scripts/ascension_family.gd" id="1"]
[ext_resource type="Script" path="res://data/ascensions/scripts/ascension.gd" id="2"]
[ext_resource type="Script" path="res://data/ascensions/effects/replication_feed_effect.gd" id="3"]

[sub_resource type="Resource" id="Effect_tier1"]
script = ExtResource("3")
shards = 1

[sub_resource type="Resource" id="Effect_tier2"]
script = ExtResource("3")
shards = 2

[sub_resource type="Resource" id="Ascension_tier1"]
script = ExtResource("2")
description = "Choose a unit: whenever it plays its Gambit, it gets a random Shard for the rest of combat (it combines with a Shard it holds, if it can)."
tier = 1
target = 1
requires_gambit = true
effect = SubResource("Effect_tier1")

[sub_resource type="Resource" id="Ascension_tier2"]
script = ExtResource("2")
description = "Choose a unit: whenever it plays its Gambit, it gets {shards} random Shards for the rest of combat (each combines with a Shard it holds, if it can)."
tier = 2
target = 1
requires_gambit = true
effect = SubResource("Effect_tier2")

[resource]
script = ExtResource("1")
family_name = "Replication Feed"
versions = Array[ExtResource("2")]([SubResource("Ascension_tier1"), SubResource("Ascension_tier2")])
