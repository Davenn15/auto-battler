[sub_resource type="Resource" id="Ascension_tier1"]
script = ExtResource("2")
description = "The first time your army summons a unit, it summons the Synthecyst instead: a slow melee brawler that absorbs {absorb_share%} of the summon's max health and {stat_share%} of its attributes and Wards. While it lives, your later summons are absorbed into it instead. If it's dead, the next summon Revives it with the health it absorbs plus {revive_base_share%} of its base health."
tier = 1
effect = SubResource("Effect_tier1")

[sub_resource type="Resource" id="Ascension_tier2"]
