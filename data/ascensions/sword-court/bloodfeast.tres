[gd_resource type="Resource" script_class="AscensionFamily" format=3]

[ext_resource type="Script" path="res://data/ascensions/scripts/ascension_family.gd" id="1"]
[ext_resource type="Script" path="res://data/ascensions/scripts/ascension.gd" id="2"]
[ext_resource type="Script" path="res://data/ascensions/effects/bloodfeast_effect.gd" id="3"]

[sub_resource type="Resource" id="Effect_tier3"]
script = ExtResource("3")
heal_share = 0.08
bleed_share = 0.5
radius_cells = 3

[sub_resource type="Resource" id="Effect_tier4"]
script = ExtResource("3")
heal_share = 0.12
bleed_share = 1.0
radius_cells = 3

[sub_resource type="Resource" id="Ascension_tier3"]
script = ExtResource("2")
description = "Whenever an enemy with Bleed dies, your unit with the lowest health within {radius_cells} cells of it is healed for {heal_share%} of its max health plus {bleed_share%} of the Bleed the enemy had left."
tier = 3
effect = SubResource("Effect_tier3")

[sub_resource type="Resource" id="Ascension_tier4"]
script = ExtResource("2")
description = "Whenever an enemy with Bleed dies, your unit with the lowest health within {radius_cells} cells of it is healed for {heal_share%} of its max health plus {bleed_share%} of the Bleed the enemy had left."
tier = 4
effect = SubResource("Effect_tier4")

[resource]
script = ExtResource("1")
family_name = "Bloodfeast"
versions = Array[ExtResource("2")]([SubResource("Ascension_tier3"), SubResource("Ascension_tier4")])
