effect = SubResource("Effect_tier3")

[sub_resource type="Resource" id="Ascension_tier4"]
script = ExtResource("2")
description = "Your units gain {wrack_chance_per_glory%} Wrack Chance and {wrack_damage_per_glory%} Wrack Damage for each stack of Glory they have."
tier = 4
effect = SubResource("Effect_tier4")

[resource]
script = ExtResource("1")
family_name = "Glorious Fury"
versions = Array[ExtResource("2")]([SubResource("Ascension_tier3"), SubResource("Ascension_tier4")])
