[gd_resource type="Resource" script_class="Keepsake" format=3]

[ext_resource type="Script" path="res://data/keepsakes/scripts/keepsake.gd" id="1_keep"]
[ext_resource type="Script" path="res://data/keepsakes/scripts/empowerment.gd" id="2_3dwnv"]
[ext_resource type="Resource" path="res://data/keepsakes/combined/stubborn/celerity_ward__health_effect.tres" id="2_effect"]
[ext_resource type="Script" path="res://scripts/passive.gd" id="3_6fuyx"]

[sub_resource type="Resource" id="Resource_oorqf"]
script = ExtResource("2_3dwnv")
shard = 3
description = "Your Wards are increased by {percent%}."
effect_overrides = {
"percent": 0.75
}

[sub_resource type="Resource" id="Resource_6thpq"]
script = ExtResource("2_3dwnv")
shard = 6
description = "It works below {threshold%} Maximum Health."
effect_overrides = {
"threshold": 0.6
}

[resource]
script = ExtResource("1_keep")
keepsake_name = "Stubborn"
first_shard = 3
second_shard = 6
celerity_ward = 35.0
health = 200.0
effect = ExtResource("2_effect")
description = "Your Wards are increased by {percent%} while you are below {threshold%} Maximum Health."
empowerments = Array[ExtResource("2_3dwnv")]([SubResource("Resource_oorqf"), SubResource("Resource_6thpq")])
metadata/_custom_type_script = "uid://c24ieqfh48rkj"
