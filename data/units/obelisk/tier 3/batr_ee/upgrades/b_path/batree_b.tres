[resource]
script = ExtResource("1")
upgrade_name = "Volatile"
description = "New Gambit: Railgun. Charges up for {cast_time} seconds, building Voltage {charge_voltage_multiplier} times as fast, then spends all its Voltage on one shot at the enemy in range with the highest Might, dealing {damage} Insight damage plus {per_voltage+per_voltage_insight:insight} per Voltage spent."
gambit = ExtResource("3")
next_choices = Array[ExtResource("1")]([ExtResource("4"), ExtResource("5")])
