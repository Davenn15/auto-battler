[resource]
script = ExtResource("1")
shield_per_second = 75.0
gambit_name = "Shield Beam"
cast_time = 0.2
description = "Channels a Beam at the ally with the lowest health for {duration} seconds, shielding it for {shield_per_second+insight_scaling|shield} per second (more the farther away it is). The shield lingers for {shield_linger|shieldtime} seconds. If the ally dies, the Beam moves on to the next lowest-health ally for the time left."
