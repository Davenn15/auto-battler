[resource]
script = ExtResource("1")
profile = ExtResource("2")
gestation = 5.0
gambit_name = "Replication Seed"
cast_time = 0.75
description = "Plants a replication seed in the non-Replicator ally within {range_cells} cells with the lowest health. It hatches after {gestation} seconds, or when that ally dies, into a Replicant beside it. The longer it gestates, the more health the Replicant starts with ({min_start_health%} at once, up to full)."
