[resource]
script = ExtResource("1")
upgrade_name = "Exponential"
description = "New Gambit: Replicate. Duplicates itself into {copies} identical copies that share {health_share%} of its health and each get all of its keepsakes. Copies have Charge and can use it too. Each time any Replicator casts it, every Replicator's max Charge rises by {charge_per_cast}."
gambit = ExtResource("3")
next_choices = Array[ExtResource("1")]([ExtResource("4"), ExtResource("5")])
