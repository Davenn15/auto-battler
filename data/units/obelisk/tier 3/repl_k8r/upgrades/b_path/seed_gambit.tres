[resource]
script = ExtResource("1")
gambit_name = "Replication Seed"
cast_time = 0.75
description = "Plants a replication seed in the nearby non-REPL\\K8R ally with the lowest health. It hatches after a while, or when that ally dies, into two duplicates. The longer it gestates, the more health they start with."
