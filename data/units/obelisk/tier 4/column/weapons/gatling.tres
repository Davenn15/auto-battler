[resource]
script = ExtResource("1")
passive_name = "Gatling Cannon"
description = "Fires small shots at the nearest enemy in range for {damage+celerity_scaling} Might damage each. Shots come faster the longer it fires at the same enemy, from {start_gap} down to {min_gap} seconds apart."
