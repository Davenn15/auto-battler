[resource]
script = ExtResource("1")
passive_name = "Gatling Cannon"
description = "Fires small shots at the nearest enemy in range for 8 + 0.18x Celerity damage each. Shots come faster the longer it fires at the same enemy, from 0.8 down to 0.15 seconds apart."
