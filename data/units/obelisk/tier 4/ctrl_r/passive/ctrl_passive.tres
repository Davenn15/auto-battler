[ext_resource type="Script" uid="uid://bjs156rq7sbbv" path="res://data/units/obelisk/tier 4/ctrl_r/passive/ctrl_passive.gd" id="1"]

[resource]
script = ExtResource("1")
passive_name = "Command Link"
description = "Whenever Controller is hit, it gains {ward_per_hit} Ward of that hit's damage type for {ward_duration} seconds (up to +{ward_cap} per type). The first time it drops below 66% health, and again below 33%, it launches a siphon drone that drains {drain_share%} of an enemy's max health and heals Controller that much."
