gambit_name = "Open Gate"
cast_time = 0.4
description = "Each of its first three casts summons a different Gateling beside it: a Broad Gateling (tank, shields allies), then two Slim Gatelings (assassins that bleed and execute), then a Gatling Gateling (ranged, spins up on one target). Each has its own stats plus 20% of GATE.W(A)'s max health and 30% of its attributes and wards. Later casts summon nothing."
