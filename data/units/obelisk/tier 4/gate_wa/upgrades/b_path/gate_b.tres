[resource]
script = ExtResource("1")
upgrade_name = "Reconstructed"
description = "New Gambit: Return. Revives the last ally that died beside it with {health_share%} of its health (each ally only once). Revived allies count as its own for its passive's heal and boost. Whenever an ally dies, gains {charge} Charge."
