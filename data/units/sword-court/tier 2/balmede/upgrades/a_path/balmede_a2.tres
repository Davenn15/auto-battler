[ext_resource type="Script" path="res://scripts/upgrade.gd" id="1"]

[resource]
script = ExtResource("1")
description = "If Plant's Shield isn't broken by the time it ends, she gains a stack of Glory: her base max health, attributes and Wards are 5% higher for the rest of the match."
